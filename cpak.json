{
  "$schema": "https://raw.githubusercontent.com/Containerpak/cpak/v2/schema/manifest-v3.json",
  "manifest_version": "3.0",
  "name": "darktable",
  "description": "Develop and manage raw photographs.",
  "version": "5.6.1",
  "image": "ghcr.io/containerpak/darktable@sha256:b19b295027cab4b258b21113e47b541a8ac678c266767b7dc0ec984b715f28f5",
